<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_onshape" model="ir.module.category">
        <field name="name">Onshape</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_onshape_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_onshape" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_onshape_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_onshape" />
        <field name="implied_ids" eval="[(4, ref('group_onshape_user'))]" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

</odoo>
