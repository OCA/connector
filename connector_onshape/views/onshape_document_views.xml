<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Document Form View -->
    <record id="view_onshape_document_form" model="ir.ui.view">
        <field name="name">onshape.document.form</field>
        <field name="model">onshape.document</field>
        <field name="arch" type="xml">
            <form string="Onshape Document">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="backend_id" />
                            <field name="onshape_document_id" />
                            <field name="onshape_default_workspace_id" />
                            <field name="document_type" />
                            <field name="onshape_url" widget="url" />
                        </group>
                        <group>
                            <field name="owner" />
                            <field name="created_at" />
                            <field name="modified_at" />
                            <field name="onshape_webhook_id" readonly="1" />
                            <field
                                name="thumbnail"
                                widget="image"
                                options="{'size': [200, 200]}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Elements" name="elements">
                            <field name="element_ids">
                                <tree>
                                    <field name="name" />
                                    <field name="onshape_element_id" />
                                    <field name="element_type" />
                                    <field name="microversion_id" />
                                </tree>
                            </field>
                        </page>
                        <page string="Product Bindings" name="products">
                            <field name="product_binding_ids">
                                <tree>
                                    <field name="odoo_id" />
                                    <field name="onshape_part_number" />
                                    <field name="onshape_name" />
                                    <field name="match_type" />
                                    <field name="onshape_state" />
                                </tree>
                            </field>
                        </page>
                        <page string="BOM Bindings" name="boms">
                            <field name="bom_binding_ids">
                                <tree>
                                    <field name="odoo_id" />
                                    <field name="onshape_element_id" />
                                    <field name="match_score" />
                                    <field name="sync_date" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Document Tree View -->
    <record id="view_onshape_document_tree" model="ir.ui.view">
        <field name="name">onshape.document.tree</field>
        <field name="model">onshape.document</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="onshape_document_id" />
                <field name="document_type" />
                <field name="owner" />
                <field name="modified_at" />
                <field name="onshape_webhook_id" optional="hide" />
                <field name="backend_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <!-- Document Search View -->
    <record id="view_onshape_document_search" model="ir.ui.view">
        <field name="name">onshape.document.search</field>
        <field name="model">onshape.document</field>
        <field name="arch" type="xml">
            <search string="Onshape Documents">
                <field name="name" />
                <field name="onshape_document_id" />
                <field name="owner" />
                <filter
                    name="assemblies"
                    string="Assemblies"
                    domain="[('document_type', '=', 'assembly')]"
                />
                <filter
                    name="parts"
                    string="Part Studios"
                    domain="[('document_type', '=', 'part')]"
                />
                <filter
                    name="drawings"
                    string="Drawings"
                    domain="[('document_type', '=', 'drawing')]"
                />
                <separator />
                <filter
                    name="no_webhook"
                    string="No Webhook"
                    domain="[('onshape_webhook_id', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_type"
                        string="Type"
                        context="{'group_by': 'document_type'}"
                    />
                    <filter
                        name="group_owner"
                        string="Owner"
                        context="{'group_by': 'owner'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_onshape_document" model="ir.actions.act_window">
        <field name="name">Onshape Documents</field>
        <field name="res_model">onshape.document</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_onshape_document_search" />
    </record>

    <menuitem
        id="menu_onshape_documents"
        name="Documents"
        parent="menu_onshape_data"
        action="action_onshape_document"
        sequence="10"
    />

</odoo>
